<?xml version="1.0"?>
<model>
  <name>ground_stereo_rig</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Interceptor Simulation (T16, Phase 2 sim-to-real)</name>
    <email>emersonium2@gmail.com</email>
  </author>
  <description>
    Static ground-based two-camera stereo rig for Phase-2 T16 (ADR-0046 F1:
    trajectory-matched offline-render replay). One static link carries two
    camera sensors, rig_left and rig_right, 2.0 m baseline (+/-1.0 m along
    the link's lateral Y axis), fronto-parallel (no toe-in), horizontal_fov
    0.349 rad (~20 deg, ADR-0017's 16 mm-equiv lens), 1920x1200 @ 10 Hz,
    clip 0.1/3000 m. See docs/stereo_design.md (physical design),
    docs/rig_geometry_analysis.md (placement/wedge coverage), and
    worlds/stereo_intercept.sdf (deployment: broadside_160m pose).
  </description>
</model>
