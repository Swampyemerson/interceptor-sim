<?xml version="1.0" encoding="UTF-8"?>
<!--
  REPO-LOCAL SHADOW of PX4's Tools/simulation/gz/models/mono_cam/model.sdf.

  Why this file exists (ADR-0024 addendum, Tier-2 acquisition-range work):
  The ONLY change from PX4's original is <horizontal_fov> 1.74 -> 1.0472 rad
  (99.7 deg -> 60 deg). A narrower/longer lens magnifies the tag (fx 539.9 ->
  ~1108.5 px) so it is detectable at ~2x the range (~6 m -> ~12 m), which buys
  terminal correction time (capacity proportional to t_go^2, ADR-0023) and lifts
  the 9 m/s handoff-latch rate (ADR-0027). This is a disclosed hardware-analog
  change (a real seeker's lens choice), NOT tag inflation (ADR-0010 boundary):
  the tag's physical size is unchanged; M2's detection envelope is re-baselined
  and disclosed, not assumed.

  Resolution: gz finds this via `model://mono_cam` because every launch script
  puts $REPO_ROOT/models first in GZ_SIM_RESOURCE_PATH, ahead of PX4's model dir
  (same mechanism as models/apriltag_target/, ADR-0005). PX4's tree is untouched
  (ADR-0001). MAINTENANCE NOTE: if a future PX4 update changes mono_cam, this
  shadow goes stale (it is a full copy) — diff against PX4's original on upgrade.
-->
<sdf version='1.9'>
  <model name='mono_cam'>
    <pose>0 0 0 0 0 0</pose>
    <self_collide>false</self_collide>
    <static>false</static>
    <link name="camera_link">
      <inertial>
        <pose>0.03 0.03 0.03 0 0 0</pose>
        <mass>0.050</mass>
        <inertia>
          <ixx>0.00004</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00004</iyy>
          <iyz>0</iyz>
          <izz>0.00004</izz>
        </inertia>
      </inertial>
      <visual name="mono_cam/visual/housing">
        <geometry>
          <box>
            <size>0.02 0.04 0.04</size>
          </box>
        </geometry>
      </visual>
      <visual name="mono_cam/visual/lens">
        <pose>0.015 0 0 0 1.5707 0</pose>
        <geometry>
          <cylinder>
            <radius>0.008</radius>
            <length>0.01</length>
          </cylinder>
        </geometry>
      </visual>
      <visual name="mono_cam/visual/lens_glass">
        <pose>0.014 0 0 0 0 0</pose>
        <geometry>
          <sphere>
            <radius>0.0079</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>.4 .4 .5 .95</ambient>
          <diffuse>.4 .4 .5 .95</diffuse>
          <specular>1 1 1 1</specular>
          <emissive>0 0 0 1</emissive>
        </material>
      </visual>
      <sensor name="imager" type="camera">
        <gz_frame_id>camera_link</gz_frame_id>
        <pose>0 0 0 0 0 0</pose>
        <camera>
          <!-- Tier-2: 60 deg (was 1.74 rad / 99.7 deg). See header + ADR-0024 addendum. -->
          <horizontal_fov>1.0472</horizontal_fov>
          <image>
            <width>1280</width>
            <height>960</height>
          </image>
          <clip>
            <near>0.1</near>
            <far>3000</far>
          </clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <visualize>true</visualize>
      </sensor>
      <gravity>true</gravity>
      <velocity_decay />
    </link>
  </model>
</sdf>
