<?xml version="1.0"?>
<model>
  <name>demo_ground_grid</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Interceptor Simulation (portfolio demo polish)</name>
    <email>emersonium2@gmail.com</email>
  </author>
  <description>
    TEXTURE-ONLY asset, not a spawned model (there is no model.sdf here on
    purpose -- nothing ever includes model://demo_ground_grid, it is only
    referenced as model://demo_ground_grid/grid_ground.png from
    worlds/apriltag_demo.sdf's ground_plane visual material, mirroring how
    models/apriltag_target/tag36h11_00000.png is referenced by both the
    apriltag_target and fpv_target models). This model.config exists so the
    model:// URI resolves consistently the same way the tag texture does;
    the &lt;sdf&gt; tag above points at a file that intentionally does not
    exist since this "model" is never included/spawned.
  </description>
</model>
