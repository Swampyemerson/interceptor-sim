<?xml version="1.0"?>
<model>
  <name>apriltag_target</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Interceptor Simulation (M2)</name>
    <email>emersonium2@gmail.com</email>
  </author>
  <description>
    Static AprilTag 36h11 id-0 target board for M2 (AprilTag detection vs
    ground truth). See docs/goals.md milestone M2 and docs/decisions.md ADR-0003
    (pupil-apriltags). Textured square is 0.625 m/side; the black-square
    edge pupil-apriltags measures (tag_size) is 0.5 m -- see model.sdf for
    the full geometry derivation.
  </description>
</model>
