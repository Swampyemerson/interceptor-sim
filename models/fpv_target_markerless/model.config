<?xml version="1.0"?>
<model>
  <name>fpv_target_markerless</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Interceptor Simulation (post-M5, ADR-0033 item 2)</name>
    <email>emersonium2@gmail.com</email>
  </author>
  <description>
    Markerless FPV target for ADR-0033 post-M5 queue item 2 (kill the
    AprilTag). This is a copy of the models/fpv_target enemy-quad airframe
    with the AprilTag plane deliberately removed, so it carries no fiducial at
    all. It is the target the future markerless seeker (classical CV plus a
    lightweight pre-built neural net feeding the same bearing interface) must
    detect by body, shape, and motion instead of a printed tag, which attacks
    the project disclosed number-one risk. Like models/fpv_target and
    models/apriltag_target it is static with no collision and no inertia, so it
    flies identically under scripts/m4_target_mover.py; every body part is
    copied byte-identical from models/fpv_target and only the tag was dropped.
    Static-checked with gz sdf --check only; live-spawn and detection
    validation are deferred to post-M5 because a Monte-Carlo batch is running.
  </description>
</model>
