# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/

# Simulation logs & artifacts (regenerable; analyze from logs/ locally).
# `logs/*` NOT `logs/`: git cannot re-include (`!`) a path inside a fully
# ignored directory, and the audited evidence exceptions below need it.
logs/*
*.ulg

# Audit 2026-07-10 finding DEEP-H1 (docs/audit_findings_tracker.md): the tiny
# aggregate result CSVs the README/ADRs cite as evidence are COMMITTED so the
# published numbers survive disk loss. Big per-tick flight CSVs, ulogs, sim
# logs, and images stay ignored — only these small aggregates are re-included.
!logs/mc_final_*.csv
!logs/mc_t21_*.csv
!logs/mc_realistic_*.csv
# M3 gate evidence (README/PROGRESS: standoff err 0.018 / 0.035 m)
!logs/m3_intercept_20260705T000619Z.csv
!logs/m3_intercept_20260705T000818Z.csv
# M4 gate evidence (README/PROGRESS: pronav 0.402/0.277/0.443 m vs
# pursuit 2.544/2.109/2.048 m, three paired gate runs)
!logs/m4_intercept_pronav_20260705T032238Z.csv
!logs/m4_intercept_pronav_20260705T032528Z.csv
!logs/m4_intercept_pronav_20260705T033250Z.csv
!logs/m4_intercept_pursuit_20260705T032138Z.csv
!logs/m4_intercept_pursuit_20260705T032425Z.csv
!logs/m4_intercept_pursuit_20260705T033147Z.csv

# Regenerable analysis plots from mc_analyze.py (the committed plots/stereo_*.png are kept deliberately)
plots/pk_vs_radius_*.png
plots/miss_hist_cdf_*.png
plots/miss_cdf_*.png
plots/per_path_*.png
plots/traj_overlay_*.png

# Markerless-seeker prototype (ADR-0033 item 2): isolated venv, downloaded model
# weights, and regenerable eval artifacts — the .py modules ARE tracked.
.venv-seeker/
scripts/seeker/weights/
scripts/seeker/out/
scripts/seeker/eval_out/
scripts/seeker/twostage_out/
scripts/seeker/eval_tag_boxes.json

# Drone-specific detector lane (ADR-0033 task #9): its own train/export venv
# (torch/ultralytics, large) and downloaded/generated training data — the
# drone_detector_eval.py / train_drone_finetune.py modules ARE tracked.
.venv-seeker-train/
scripts/seeker/data/

# Gazebo / PX4 caches that can leak into the workspace
.gz/
build/

# Demo-video capture output (regenerable frame sequences + large MP4/GIF;
# demo_out/README.md explains the pipeline and IS tracked despite the
# directory-wide ignore below. A couple of committed sample stills live in
# docs/images/ instead of here.
demo_out/*
!demo_out/README.md

