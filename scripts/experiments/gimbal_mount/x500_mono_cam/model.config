<?xml version="1.0"?>
<model>
  <name>x500_mono_cam</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <description>
    ADAPTIVE-TILT variant (#46/ADR-0065): x500_mono_cam with the CameraJoint
    changed from FIXED to a CONTROLLED REVOLUTE PITCH joint (gz JointPositionController
    on topic /gimbal/pitch_cmd). The mono_cam camera itself is UNCHANGED (same
    1280x960 imager, same intrinsics, same camera_link topic) so the NN seeker
    pipeline is untouched. Shadows the canonical PX4 x500_mono_cam via a
    models/x500_mono_cam symlink + GZ_SIM_RESOURCE_PATH user-path precedence.
  </description>
</model>
