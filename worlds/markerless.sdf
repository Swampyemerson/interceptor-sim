<?xml version="1.0" encoding="UTF-8"?>
<!--
  MARKERLESS world (ADR-0033 post-M5 queue item 2: "kill the AprilTag").

  BYTE-IDENTICAL to worlds/apriltag.sdf (physics / scene / ground_plane / sun /
  spherical_coordinates kept EXACTLY -- PX4's gz_bridge depends on it, GOALS.md
  M2) EXCEPT for two deliberate changes, both required for the markerless A/B:

    1. World name is "markerless" (not "apriltag"). Every gz-transport topic for
       this run keys off it, e.g.
       /world/markerless/model/x500_mono_cam_0/link/camera_link/sensor/imager/image
       and /world/markerless/set_pose. The whole flight stack already reads the
       world name from the INTERCEPTOR_WORLD_NAME env var (scripts/m2_detect.py's
       WORLD_NAME, reused by m3/m4/mover/s2_cue_mock), so set
       INTERCEPTOR_WORLD_NAME=markerless to match this file.

    2. The target <include> is models/fpv_target_markerless (the tag-LESS enemy
       quad body) instead of models/apriltag_target (the fiducial board). Same
       pose (5, 0, 0.5), same identity orientation -- the markerless body bakes
       its approach-facing (-X) side into geometry exactly as apriltag_target
       bakes the tag facing (see that model's model.sdf). The target model NAME
       here is "fpv_target_markerless"; the flight stack now reads the target
       model name from INTERCEPTOR_TARGET_MODEL (default "apriltag_target"), so
       set INTERCEPTOR_TARGET_MODEL=fpv_target_markerless to move/pre-place it.

  Launch (mirrors worlds/apriltag.sdf): reachable as
  ${PX4_GZ_WORLDS}/markerless.sdf at runtime (symlink like apriltag.sdf), models
  via GZ_SIM_RESOURCE_PATH:

    PX4_GZ_WORLD=markerless \
    GZ_SIM_RESOURCE_PATH=/home/emerson/interceptor-sim/models \
    HEADLESS=1 make px4_sitl gz_x500_mono_cam
-->
<sdf version="1.9">
  <world name="markerless">
    <physics type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>
    <scene>
      <grid>false</grid>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>1 1</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>500 500</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>
    <light name="sunUTC" type="directional">
      <pose>0 0 500 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.001 0.625 -0.78</direction>
      <diffuse>0.904 0.904 0.904 1</diffuse>
      <specular>0.271 0.271 0.271 1</specular>
      <attenuation>
        <range>2000</range>
        <linear>0</linear>
        <constant>1</constant>
        <quadratic>0</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg> 8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

    <!-- Markerless target: tag-less enemy quad body at (5, 0, 0.5), approach
         face (-X) toward the interceptor at origin (see
         models/fpv_target_markerless/model.sdf for the facing derivation --
         same convention as apriltag_target). NO fiducial: the seeker must lock
         the body. -->
    <include>
      <uri>model://fpv_target_markerless</uri>
      <name>fpv_target_markerless</name>
      <pose>5 0 0.5 0 0 0</pose>
    </include>
  </world>
</sdf>
