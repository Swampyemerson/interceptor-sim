// Counter-UAS Interceptor — Functional Block Diagram
// Render:  dot -Tsvg architecture_block_diagram.dot -o architecture_block_diagram.svg
//          dot -Tpng -Gdpi=150 architecture_block_diagram.dot -o architecture_block_diagram.png
digraph FunctionalBlock {
  rankdir=LR;
  bgcolor="white";
  fontname="DejaVu Sans";
  labelloc="t";
  fontsize=20;
  label=<<b>Counter-UAS Interceptor &#8212; Functional Block Diagram</b><br/><font point-size="11" color="#555555">Two-sensor architecture: ground stereo cue &#8594; one-way handoff &#8594; onboard camera-only terminal (proportional navigation).</font>>;
  nodesep=0.35; ranksep=0.7;
  node [fontname="DejaVu Sans", fontsize=11, shape=box, style="rounded,filled", color="#37474f", fillcolor="#eceff1", penwidth=1.4, margin="0.18,0.10"];
  edge [fontname="DejaVu Sans", fontsize=9, color="#455a64", penwidth=1.3, arrowsize=0.8];

  // ---------------- GROUND SEGMENT ----------------
  subgraph cluster_ground {
    label=<<b>GROUND SEGMENT</b>   <font point-size="9" color="#777777">stereo cue node &#183; target-real pipeline (T16&#8211;T19); sim uses a statistics mock</font>>;
    style="rounded,filled"; fillcolor="#e3f2fd"; color="#1565c0"; fontname="DejaVu Sans"; fontsize=12; margin=14;
    gcamL [label="Stereo Cam L\nAR0234 global shutter\n1920&#215;1200 &#183; 16 mm", fillcolor="#ffffff"];
    gcamR [label="Stereo Cam R\n2.0 m baseline", fillcolor="#ffffff"];
    gdet  [label="NN drone detector\ndetect-then-track\nYOLO11n (sim) / YOLOX&#183;MIT (real)"];
    gtri  [label="Stereo triangulation\n&#963;_R &#8776; 4.45e-5 &#183; R&#178;"];
    gtrk  [label="Track filter\nposition + velocity"];
    gemit [label="Cue emitter\n~90-byte UDP track msg", fillcolor="#e1f5fe"];
    gcamL -> gdet; gcamR -> gdet; gdet -> gtri -> gtrk -> gemit;
  }

  // ---------------- LINK ----------------
  link [label="UDP datalink\n⚡ JAMMABLE", shape=octagon, style="filled", fillcolor="#ffcdd2", color="#c62828", fontcolor="#b71c1c", penwidth=1.8];
  gemit -> link [style=bold];

  // ---------------- AIR SEGMENT ----------------
  subgraph cluster_air {
    label=<<b>INTERCEPTOR &#8212; AIR SEGMENT</b>   <font point-size="9" color="#777777">flight compute: Raspberry Pi 5 + Hailo-8 (ADR-0063)</font>>;
    style="rounded,filled"; fillcolor="#e8f5e9"; color="#2e7d32"; fontname="DejaVu Sans"; fontsize=12; margin=14;
    amono [label="Onboard mono camera\ngz_x500_mono_cam", fillcolor="#ffffff"];
    aseek [label="Markerless NN seeker\n+ CSRT tracker\n(AprilTag = early sim stand-in, removed)"];
    abr   [label="Bearing + range\ncamera-only measurement"];
    acue  [label="Cue reader\nMID-COURSE ONLY", fillcolor="#e1f5fe"];
    afuse [label="Fusion (fixed-weight polar)\ncue → range / velocity ONLY\nNEVER bearing", fillcolor="#fff9c4", color="#f9a825"];
    aguid [label="Guidance\npursuit → PRO-NAV (N=5)"];
    apx4  [label="PX4 SITL / MAVSDK\noffboard velocity + attitude", fillcolor="#ffffff"];
    amono -> aseek -> abr;
    abr -> afuse [label="camera (mid-course)"];
    acue -> latch [style=dashed, color="#e65100"];
    latch -> afuse [label="mid-course cue", color="#e65100"];
    afuse -> aguid [label="mid-course dash"];
    apx4;
    aguid -> apx4;
  }

  link -> acue [style=bold];

  // ---------------- ONE-WAY HANDOFF LATCH (the load-bearing element) ----------------
  latch [label="◆ ONE-WAY HANDOFF LATCH ◆\ncue reader DESTROYED at latch\ninstrumented: 0 post-handoff cue reads", shape=box, style="filled,bold", fillcolor="#fff3e0", color="#e65100", fontcolor="#bf360c", penwidth=2.4];

  // Terminal camera-only path (post-latch) — the headline jam-resistance
  abr -> aguid [color="#e65100", penwidth=2.2, fontcolor="#bf360c", label=<<b>TERMINAL: camera-only</b>>];

  // ---------------- Rejected/optional fusion variant ----------------
  aekf [label="EKF covariance-gated fusion\nbenched — DEFAULT-OFF (ADR-0044)", style="rounded,filled,dashed", fillcolor="#f5f5f5", fontcolor="#9e9e9e", color="#bdbdbd", fontsize=9];
  aekf -> afuse [style=dotted, color="#bdbdbd", label="alt (rejected)", fontcolor="#9e9e9e"];

  // ---------------- Honesty boundary ----------------
  honesty [label="Honesty boundary: gt_* (ground truth) = scoring / logging ONLY — never a guidance input;\nthe cue is structurally unreadable after the latch.", shape=note, style="filled,dashed", fillcolor="#fafafa", fontcolor="#616161", color="#9e9e9e", fontsize=9];
  { rank=sink; honesty; aekf; }
}
